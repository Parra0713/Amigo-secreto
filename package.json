    "simular": "node tests/simulador.js",
    "voz": "node tools/descargar-voz.mjs",
    "voces": "node tools/prerenderizar.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.6"
  }
}
