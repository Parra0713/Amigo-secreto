{
  "name": "plan-amigo-secreto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juego de revelación del amigo secreto, estilo El Plan del Diablo. Servidor local para PC anfitrión + celulares.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test \"tests/*.test.js\"",
